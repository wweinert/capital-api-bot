{
  "schemaVersion": 1,
  "platformRoot": "lab",
  "protectedPaths": [
    ".env",
    ".env.*",
    "api.js",
    "bot.js",
    "config.js",
    "monitors.js",
    "indicators/**",
    "services/**",
    "strategies/**",
    "utils/**"
  ],
  "candidatePathPrefix": "lab/experiments/active/",
  "evaluatorPathPrefix": "lab/evaluators/",
  "requiredMetrics": [
    "netReturn",
    "maxDrawdown",
    "profitFactor",
    "tradeCount",
    "positivePeriodRate"
  ],
  "contaminatedPeriods": [
    {
      "from": "2026-06-01",
      "to": "2026-06-30",
      "reason": "Repeatedly inspected and used in prior selection reports."
    }
  ],
  "allowedStatuses": [
    "draft",
    "specified",
    "ready",
    "evaluated",
    "rejected",
    "probation",
    "approved"
  ],
  "agentTerminalStatuses": ["rejected", "probation"],
  "safety": {
    "brokerAccess": "none",
    "networkAccess": "none",
    "lockedTestAccess": "human-only",
    "humanApprovalRequired": true
  }
}
